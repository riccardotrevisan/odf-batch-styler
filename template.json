{
  "modifications": [
    {
      "type": "import_style",
      "rules": [
        {
          "style_name": "Critical",
          "family": "text",
          "source_file": "styleref.odt"
        },
        {
          "style_name": "Heading_Custom",
          "family": "paragraph",
          "source_file": "styleref.odt"
        }
      ]
    },
    {
      "type": "regex_styler",
      "rules": [
        {
          "pattern": "\\+IMPORTANT: (.*)",
          "style_name": "Critical"
        },
        {
          "pattern": "^Chapter \\d+",
          "style_name": "Heading_Custom"
        }
      ]
    }
  ]
}
